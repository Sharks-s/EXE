{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusBuddy",
  "version": "0.1.0",
  "identifier": "com.focusbuddy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FocusBuddy",
        "width": 900,
        "height": 650,
        "minWidth": 800,
        "minHeight": 600,
        "visible": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "devtools": true
      },
      {
        "label": "widget",
        "title": "FocusBuddy Widget",
        "width": 130,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "devtools": true
      },
      {
        "label": "warning",
        "title": "FocusBuddy Warning",
        "width": 800,
        "height": 550,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "devtools": true
      },
      {
        "label": "widget-bubble",
        "title": "FocusBuddy Bubble",
        "width": 180,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "devtools": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": true,
      "tooltip": "FocusBuddy"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/system-sounds/*"
    ],
    "externalBin": [
      "binaries/focusbuddy-bot"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
