{
  "name": "desktop-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-with-rename.js",
    "build:app": "npm run tauri build",
    "msix:cert": "winapp cert generate --if-exists skip",
    "msix:stage": "node scripts/stage-msix.js",
    "pack:msix": "tauri build --no-bundle && npm run msix:stage && winapp package .\\msix-dist --manifest .\\Package.appxmanifest --exe desktop-app.exe --cert .\\devcert.pfx",
    "pack:msix:store": "tauri build --no-bundle && npm run msix:stage && winapp package .\\msix-dist --manifest .\\Package.appxmanifest --exe desktop-app.exe --no-sign --output .\\FocusBuddy_Store_x64.msix",
    "msix:install-cert": "winapp cert install .\\devcert.pfx"
  },
  "dependencies": {
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@hookform/resolvers": "3.9.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.100.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.3",
    "axios": "^1.16.1",
    "i18next": "^26.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.3.0",
    "zod": "3.24.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@microsoft/winappcli": "^0.7.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
